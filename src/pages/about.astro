---
import HirakuLayout from "../layouts/hiraku-layout.astro";
import "../styles/pages/about.css";
---

<HirakuLayout title="About NECESS.">
  <section id="hero">
    <div class="crumbs">
      <a href="/" data-cursor="link">
        HIRAKU WORK
      </a>
      <span class="arr">→</span>
      <b>ABOUT</b>
      <span class="arr">·</span>
      <span style="opacity: .55;">04 / 05</span>
    </div>

    <div class="hero-grid">
      <h1 class="hero-title">
        <span class="line">
          <span class="w">About</span>
        </span>
        <span class="line">
          <span class="w">
            NECESS<span class="dot">.</span>
          </span>
        </span>
      </h1>

      <div class="hero-sub">
        <h2 class="ja">
          必要とされる、
          <br />
          会社であるために。
        </h2>

        <div class="en">
          We start <em>from yes.</em>
        </div>

        <p>
          HIRAKU WORK
          を運営する株式会社ナッセは、福祉介護施設の開業支援から、介護・障害福祉サービスの運営まで、幅広く事業を展開しています。社名は「Necessary（必要な）」に由来します。
        </p>
      </div>
    </div>
  </section>
</HirakuLayout>
