---
import Base from "../layouts/Base.astro";
import "../styles/pages/about.css";
---

<Base title="About NECESS.">
  <section id="hero">
    <div class="hero-inner">
      <div class="hero-breadcrumb">
        <a href="/">HOME</a>
        <span>/</span>
        <span>ABOUT</span>
      </div>

      <h1 class="hero-title">
        <span>About</span>
        <span>NECESS.</span>
      </h1>

      <div class="hero-content">
        <h2>
          必要とされる、
          <br />
          会社であるために。
        </h2>

        <p class="hero-en">We start from yes.</p>

        <p class="hero-description">
          私たちは、必要とされる存在であり続けるために、
          一人ひとりの想いと向き合い、新しい価値を生み出していきます。
        </p>
      </div>
    </div>
  </section>
</Base>
