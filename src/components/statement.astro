---
import "../styles/hiraku-statement.css";
---

<section id="statement" data-screen-label="02 Statement">
  <div class="stmt-stage">
    <span class="stmt-mark stmt-mark--tl">— Manifesto · 02</span>
    <span class="stmt-mark stmt-mark--tr">EST · 2019 — IKOMA, NARA</span>
    <span class="stmt-mark stmt-mark--bl">N · 34.6845°</span>
    <span class="stmt-mark stmt-mark--br">E · 135.6997°</span>

    <div class="stmt-text">
      <p class="line">
        <span class="w">We</span>
        <span class="w">make</span>
        <span class="w">work</span>
      </p>

      <p class="line italic-line">
        <span class="w">that</span>
        <span class="w">makes</span>
        <span class="w">life.</span>
      </p>

      <p class="jp">働くことが、生きることになる場所を、つくる。</p>
      <p class="sign">— HIRAKU WORK · MANIFESTO 2019</p>
    </div>
  </div>
</section>

<script>
  import "../scripts/statement.js";
</script>