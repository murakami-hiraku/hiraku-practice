---
import "../styles/hiraku-facilities.css";
---

<section id="facilities" data-screen-label="05 Facilities">

  <!-- IKOMA -->
  <div class="fac-screen">
    <div class="fac-text">
      <div class="num">01 / IKOMA — Headquarters</div>

      <h3>
        <span class="ch">I</span>
        <span class="ch">k</span>
        <span class="ch">o</span>
        <span class="ch">m</span>
        <span class="ch">a</span>
        <span class="ch">.</span>
      </h3>

      <div class="ja">HIRAKU WORK 生駒事業所</div>

      <p>
        Webサイトやチラシ、ロゴの制作、事務作業の代行に取り組んでいます。
      </p>

      <a href="/ikoma/" class="fac-link">
        View detail <span>→</span>
      </a>
    </div>

    <div class="fac-photo">
      <div class="clip-wrap">
        <img src="/hiraku/images/office-wide.jpg" alt="生駒事業所" />
      </div>
      <div class="glow"></div>
    </div>
  </div>

  <!-- KORIYAMA -->
  <div class="fac-screen">
    <div class="fac-text">
      <div class="num">02 / KORIYAMA — Satellite</div>

      <h3>
        <span class="ch">K</span>
        <span class="ch">o</span>
        <span class="ch">r</span>
        <span class="ch">i</span>
        <span class="ch">y</span>
        <span class="ch">a</span>
        <span class="ch">m</span>
        <span class="ch">a</span>
        <span class="ch">.</span>
      </h3>

      <div class="ja">HIRAKU WORK 郡山</div>

      <p>
        レジンを使ったキーホルダー制作に取り組んでいます。JR郡山駅から徒歩約2分の事業所です。
      </p>

      <a href="/koriyama/" class="fac-link">
        View detail <span>→</span>
      </a>
    </div>

    <div class="fac-photo">
      <div class="clip-wrap">
        <img src="/hiraku/images/koriyama.webp" alt="HIRAKU WORK 郡山" />
      </div>
      <div class="glow"></div>
    </div>
  </div>

  <!-- CLEAN -->
  <div class="fac-screen">
    <div class="fac-text">
      <div class="num">03 / CLEAN — Hospitality</div>

      <h3>
        <span class="ch">C</span>
        <span class="ch">l</span>
        <span class="ch">e</span>
        <span class="ch">a</span>
        <span class="ch">n</span>
        <span class="ch">.</span>
      </h3>

      <div class="ja">HIRAKU WORK Clean</div>

      <p>
        清掃や、奈良市のリネン工場でタオルやシーツ、浴衣を畳み、整え、出荷する施設外就労です。
      </p>

      <a href="/clean/" class="fac-link">
        View detail <span>→</span>
      </a>
    </div>

    <div class="fac-photo">
      <div class="clip-wrap">
        <img src="/hiraku/images/clean.webp" alt="Clean" />
      </div>
      <div class="glow"></div>
    </div>
  </div>

</section>

<script>
  import "../scripts/facilities.js";
</script>